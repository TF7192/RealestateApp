# Estia LangGraph agent — environment template.
# Copy to a `.env` at the REPO ROOT (langgraph.json points "env" there).
# NEVER commit real keys. .env is gitignored.

# ─── Required: model ─────────────────────────────────────────────────
# Anthropic API key for claude-haiku-4-5 (used by ChatAnthropic).
ANTHROPIC_API_KEY=

# ─── Required: Estia backend (where the tools call back to) ──────────
# Base URL of the Estia backend that exposes /internal/agent-tool.
# e.g. https://estia.co.il  (no trailing slash, no /internal suffix)
ESTIA_API_BASE=

# Service token shared with backend/src/routes/internalAgentTool.ts.
# SKELETON: a single static token. PRODUCTION: replace with a
# short-lived per-agent signed token (see the security TODOs).
ESTIA_INTERNAL_TOKEN=

# ─── Optional: LangSmith tracing (auto-wired when set) ───────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=estia-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
