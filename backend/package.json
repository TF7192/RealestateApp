{
  "name": "estia-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cp -R src/data dist/data",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:rotate-demo-passwords": "tsx scripts/rotate-demo-passwords.ts",
    "backfill:slugs": "tsx src/scripts/backfill-slugs.ts",
    "backfill:owners": "tsx src/scripts/backfill-owners.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-ses": "^3.1090.0",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.10.0",
    "heic-convert": "^2.1.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.2",
    "langsmith": "^0.8.3",
    "openai": "^6.48.0",
    "pdfkit": "^0.19.1",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.49.1",
    "posthog-node": "^5.45.2",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.3",
    "striptags": "^3.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^5.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2"
  }
}
