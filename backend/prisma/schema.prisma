// Estia real-estate CRM — database schema
// Designed to hold everything from the Hebrew docs + PRD + the frontend mock data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// P1-7 — String columns converted to enums (DB-audit binary-sleeping-mist).
// Lowercase / snake_case members preserve the existing on-disk values
// so the migration is data-preserving (USING "col"::"<EnumType>").
enum AgreementStatus {
  SENT
  SIGNED
  EXPIRED
  CANCELLED
}

enum OwnerPhoneKind {
  primary
  secondary
  spouse
  work
  fax
  other
}

enum UploadedFileKind {
  property_image
  signed_agreement
  document
  other
}

enum MarketListingStatus {
  active
  removed
  unknown
}

enum MarketListingKind {
  forsale
  rent
}

enum MarketListingPosterType {
  private
  agency
}

enum MarketWatcherRunStatus {
  running
  success
  failed
  skipped
}

enum MarketContextKind {
  buy
  rent
}

enum UserRole {
  AGENT
  CUSTOMER
  // Sprint 1 / MLS parity — Task A1. An OWNER is an agency owner who
  // sees every agent in their `Office`. Defaults to AGENT-scoped
  // visibility when no office is attached.
  OWNER
  // SEC-010 — platform-wide administrator. Replaces the brittle
  // ADMIN_EMAILS env allowlist. The single existing platform admin
  // (talfuks1234@gmail.com) is migrated to role=ADMIN by the follow-up
  // backfill migration; all admin-gated routes read the role off the
  // JWT instead of comparing email strings.
  ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum AssetClass {
  RESIDENTIAL
  COMMERCIAL
}

enum PropertyCategory {
  SALE
  RENT
}

enum PropertyStatus {
  ACTIVE
  PAUSED
  SOLD
  RENTED
  ARCHIVED
  // Sprint 1 / MLS parity — Task J9. Nadlan's `StatusID` exposes three
  // extra life-cycle values that we need for conversion parity. UI
  // labels: אקטואלי (ACTIVE) · לא אקטואלי (INACTIVE) · מוקפא (PAUSED)
  // · נמכר (SOLD) · הושכר (RENTED) · מבוטל (CANCELLED) · עיסקה
  // (IN_DEAL). ARCHIVED stays for the existing soft-delete UX.
  INACTIVE
  CANCELLED
  IN_DEAL
}

// Sprint 1 / MLS parity — Task J9. Pipeline stage is *orthogonal* to
// status: a property can be `ACTIVE` (listed) at many different stages
// of its relationship with the office (watching / in-progress / signed
// non-exclusive / signed exclusive / exclusivity ended / refused
// brokerage / removed). Hebrew UI labels per the Nadlan form:
//   WATCHING             → במעקב
//   PRE_ACQUISITION      → טרום גיוס
//   IN_PROGRESS          → נכס בטיפול              (default for legacy rows)
//   SIGNED_NON_EXCLUSIVE → נכס חתום בהסכמה
//   SIGNED_EXCLUSIVE     → נכס חתום בלעדי
//   EXCLUSIVITY_ENDED    → בלעדיות הסתיימה
//   REFUSED_BROKERAGE    → לא מעוניין בתיווך
//   REMOVED              → הסר מנכסים בטיפול
enum PropertyStage {
  WATCHING
  PRE_ACQUISITION
  IN_PROGRESS
  SIGNED_NON_EXCLUSIVE
  SIGNED_EXCLUSIVE
  EXCLUSIVITY_ENDED
  REFUSED_BROKERAGE
  REMOVED
}

// Sprint 1 / MLS parity — Task J9. Owner-side seriousness rating (how
// serious the *seller* is, not the buyer lead). Nadlan's `SeriousID`
// Hebrew labels: לא (NONE) · די (SORT_OF) · בינוני (MEDIUM) · מאד (VERY).
enum Seriousness {
  NONE
  SORT_OF
  MEDIUM
  VERY
}

// Sprint 3 / MLS parity — Task J5. Building / unit condition, distinct
// from the free-text `renovated` hint which stays for legacy rows.
enum PropertyCondition {
  NEW // חדש מקבלן
  AS_NEW // חדש
  RENOVATED // משופץ
  PRESERVED // שמור
  NEEDS_RENOVATION // דורש שיפוץ
  NEEDS_TLC // זקוק לחידוש
  RAW // שלד / מעטפת
}

// Sprint 1 / MLS parity — Task D1. Standalone reminder ("תזכורת").
// Orthogonal to LeadMeeting (which is a calendar-synced meeting with a
// lead). A reminder can float (no anchor) or attach to a lead /
// property / customer for quick navigation.
enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  HOT
  WARM
  COLD
}

enum LeadInterestType {
  PRIVATE
  COMMERCIAL
}

// 2026-04-30 — leads split into two kinds. BUYER (legacy/default) is
// the classic "interested party" — someone briefing the agent on what
// they want to buy/rent. SELLER is a "ליד גיוס" — an owner the agent
// wants to recruit as a listing; the city/neighborhood/street/rooms/
// budget fields on Lead double as the property snapshot for those
// rows (no separate Property row is created until the recruitment
// converts).
enum LeadKind {
  BUYER
  SELLER
}

enum LeadLookingFor {
  BUY
  RENT
}

// Sprint 1 / MLS parity — Task K2. Customer-facing life-cycle status
// (Nadlan `CustomerStatusID`). Distinct from LeadStatus (HOT/WARM/COLD),
// which stays as the thermal temperature rating. Hebrew labels:
//   ACTIVE    → אקטואלי
//   INACTIVE  → לא אקטואלי
//   CANCELLED → מבוטל
//   PAUSED    → מוקפא
//   IN_DEAL   → עיסקה
//   BOUGHT    → קנה
//   RENTED    → שכר
enum CustomerStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  PAUSED
  IN_DEAL
  BOUGHT
  RENTED
}

// Sprint 1 / MLS parity — Task K2. Purpose of search, multi-select.
// Nadlan `PurposeList` Hebrew labels: השקעה · מגורים · מסחרי · קומבינציה.
enum CustomerPurpose {
  INVESTMENT
  RESIDENCE
  COMMERCIAL
  COMBINATION
}

// Sprint 2 / MLS parity — Task L1. Quick-lead status ("סטטוס ליד") —
// Nadlan's richer `LeadStatusID`. Orthogonal to `LeadStatus`
// (HOT/WARM/COLD = thermal) and `CustomerStatus` (customer lifecycle).
// Hebrew labels:
//   NEW                      → חדש
//   INTENT_TO_CALL           → בכוונת התקשרות
//   CONVERTED                → הומר
//   DISQUALIFIED             → נפסל
//   NOT_INTERESTED           → לא מעוניין
//   IN_PROGRESS              → בתהליך
//   CONVERTED_NO_OPPORTUNITY → הומר, אין הזדמנות
//   DELETED                  → נמחק
//   ARCHIVED                 → ארכיון
enum QuickLeadStatus {
  NEW
  INTENT_TO_CALL
  CONVERTED
  DISQUALIFIED
  NOT_INTERESTED
  IN_PROGRESS
  CONVERTED_NO_OPPORTUNITY
  DELETED
  ARCHIVED
}

enum DealStatus {
  NEGOTIATING
  WAITING_MORTGAGE
  PENDING_CONTRACT
  SIGNED
  FELL_THROUGH
  // E-1 — additional lifecycle values for the new "צור עסקה" flow.
  // `CLOSED` indicates a deal completed past the signing stage (funds
  // exchanged); `CANCELLED` is an explicit abandonment. Separate from
  // `FELL_THROUGH` which is a legacy value for deals that collapsed
  // mid-process.
  CLOSED
  CANCELLED
}

enum ConversationStatus {
  OPEN
  ARCHIVED
}

model Conversation {
  id            String             @id @default(cuid())
  // Every customer/agent has at most one conversation with support.
  userId        String             @unique
  user          User               @relation("UserConversations", fields: [userId], references: [id], onDelete: Cascade)
  status        ConversationStatus @default(OPEN)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  lastMessageAt DateTime           @default(now()) @db.Timestamptz(6)
  messages      Message[]

  @@index([status, lastMessageAt])
}

// Message bodies are immutable once sent — readAt is the only mutable
// field. `senderRole` disambiguates 'admin' from the user (role might
// be AGENT but still sending, so we explicitly track which side).
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderRole     String // 'user' | 'admin'
  body           String
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  readAt         DateTime?    @db.Timestamptz(6)

  @@index([conversationId, createdAt])
  // P1-1 — sender lookup. "All messages I sent" / cascading delete by
  // sender both walk this column.
  @@index([senderId])
}

enum MarketingReminderFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// ─── Offices ───────────────────────────────────────────────────────────────
// Sprint 1 / MLS parity — Task A1. A real-estate office groups multiple
// agents under one `OWNER`-role user. `officeId` on User is nullable to
// keep the existing single-agent flow working; owners see rows where
// `agentId IN (office members)`, agents still scope to their own.
model Office {
  id        String   @id @default(cuid())
  name      String
  // P2-4 — VarChar caps on contact PII.
  phone     String?  @db.VarChar(32)
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  members User[]
  // Sprint 1 / MLS parity — Task A1 fill-in. Email-based invites for
  // users who aren't yet registered. Rows auto-resolve on signup/login.
  invites OfficeInvite[]
}

// Sprint 1 / MLS parity — Task A1 fill-in. An invitation by email into
// an office. Rows are upserted on (officeId, email) so re-inviting the
// same address updates the existing row. When a user logs in or signs
// up with a matching email, auth.ts attaches them to the office and
// marks the invite accepted.
model OfficeInvite {
  id           String    @id @default(cuid())
  officeId     String
  office       Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  email        String    @db.VarChar(255)
  invitedById  String
  invitedBy    User      @relation("OfficeInvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt   DateTime? @db.Timestamptz(6)
  acceptedById String?
  acceptedBy   User?     @relation("OfficeInvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  @@unique([officeId, email])
  @@index([email])
  // P1-1 — FK lookups + cascade walks.
  @@index([invitedById])
  @@index([acceptedById])
}

// ─── Users ─────────────────────────────────────────────────────────────────
// SEC-039 — TODO: switch User.email + OfficeInvite.email to Postgres
// `citext` so case-folding lives at the DB level instead of every
// caller having to remember `.toLowerCase()` / `mode: 'insensitive'`.
// Requires `CREATE EXTENSION citext` in a migration; the schema doesn't
// currently use citext anywhere so this is a larger migration sweep,
// deferred from the SEC hardening pass.
model User {
  id                    String       @id @default(cuid())
  // P2-4 — VarChar caps. RFC 5321 caps email at 254; we use 255 to
  // match the historic ORM convention. Phones cover any plausible
  // international format including extensions.
  email                 String       @unique @db.VarChar(255)
  passwordHash          String?
  role                  UserRole
  provider              AuthProvider @default(EMAIL)
  googleId              String?      @unique
  appleId               String?      @unique
  displayName           String
  // Public, SEO-friendly identifier — used in /agents/<slug> URLs.
  slug                  String?      @unique
  phone                 String?      @db.VarChar(32)
  avatarUrl             String?
  // ── Onboarding tutorial ────────────────────────────────────────
  // Tracks whether the agent has completed (or skipped) the first-run
  // tour, and which platform they first logged in on — we only show
  // the tour on that same platform so it doesn't re-fire after a
  // device switch.
  hasCompletedTutorial  Boolean      @default(false)
  firstLoginPlatform    String? // 'web' | 'ios' | 'android'
  // A-4 — set by POST /api/me/profile when the agent finishes the
  // first-login onboarding form (license number + optional title /
  // agency / phone). If null, the SPA route guard bounces the user
  // to /onboarding from every other authed route until they submit.
  profileCompletedAt    DateTime?    @db.Timestamptz(6)
  // A-1 — soft delete. When set, /api/me rejects the request and the
  // SPA logs the user out. UI lies gracefully about "permanence" —
  // rows stay intact so a follow-up support request can restore them
  // and shared properties remain visible to co-owner agents.
  //
  // P2-3 (DB audit binary-sleeping-mist) — soft-delete is INTENTIONALLY
  // limited to User. Tenant data (Property, Lead, Owner, Deal, …) is
  // hard-deleted and relies on `onDelete: Cascade` to clean up. The
  // privacy-policy purge worker (purgeDeletedUsers.ts) finalises a
  // soft-deleted User by hard-deleting the row 30 days later, which
  // cascades to every owned tenant row. Every read of User MUST add
  // `deletedAt: null`; auth.ts already does this in middleware.
  deletedAt             DateTime?    @db.Timestamptz(6)
  // 2026-04-27 — Compliance/PPL §11. When the user accepted the
  // current Terms + Privacy Policy. Required at signup; updated when
  // a new policy version forces re-consent.
  termsAcceptedAt       DateTime?    @db.Timestamptz(6)
  // 2026-04-27 — Cookie/analytics opt-in. NULL = no decision yet
  // (essential cookies only); true = consented to PostHog product
  // analytics; false = explicitly declined. Frontend reads this so
  // it can re-prompt only when null.
  analyticsConsent      Boolean?
  analyticsConsentAt    DateTime?    @db.Timestamptz(6)
  // 2026-04-27 — JWT revocation anchor. Reject any JWT whose `iat`
  // is older than this timestamp. Bumped on password change and on
  // explicit "log out everywhere" so a leaked 30-day token is dead
  // on the next request after the user remediates.
  passwordChangedAt     DateTime?    @db.Timestamptz(6)
  // 7.1 — Google Calendar OAuth tokens. Populated by a consent flow
  // that's separate from (but layered on top of) the existing Google
  // login — agents who logged in with email can still connect their
  // Calendar. Access token expires ~1h; we keep the refresh token to
  // mint new ones server-side without user re-consent.
  googleAccessToken     String?
  googleRefreshToken    String?
  googleTokenExpiresAt  DateTime?    @db.Timestamptz(6)
  googleCalendarEnabled Boolean      @default(false)
  // 2026-05-08 — same shape, but Microsoft Graph (Outlook). Agents
  // using O365 instead of Google can connect their Outlook calendar
  // and have meetings two-way-sync. OAuth scope =
  // Calendars.ReadWrite + offline_access. Tokens refresh server-side.
  outlookAccessToken     String?
  outlookRefreshToken    String?
  outlookTokenExpiresAt  DateTime?    @db.Timestamptz(6)
  outlookCalendarEnabled Boolean      @default(false)

  // Sprint 1 / MLS parity — Task A1. Office membership. Null for the
  // legacy solo-agent flow; populated once an OWNER invites an agent
  // into their office. Deleting an office doesn't delete the users —
  // it just detaches them.
  officeId String?
  office   Office? @relation(fields: [officeId], references: [id], onDelete: SetNull)

  // Sprint 5.1 — Universal premium gate. Defaults to FALSE; every
  // 3rd-party-integration feature (Estia AI, meeting summariser, …)
  // runs through the `requirePremium` middleware which returns 402
  // PREMIUM_REQUIRED for non-premium callers. The frontend's global
  // fetch wrapper catches the status and opens the "שדרגו" dialog.
  isPremium Boolean @default(false)

  // 2026-05-06 — per-agent specialty cities. Drives the "מודעות חדשות
  // בשוק" feed: when non-empty, the market-discovery endpoint filters
  // listings to `city ∈ specialtyCities` (canonicalized via
  // `normalizeCity`). Empty array ⇒ legacy behavior (show everything),
  // so existing users see no regression. Capped to 20 entries by the
  // PATCH /api/me/specialty-cities validator.
  specialtyCities String[] @default([])

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  // Agent-specific profile
  agentProfile AgentProfile?

  // Customer-specific profile (one-to-one with a Lead row once imported)
  customerProfile CustomerProfile?

  // Audit trail
  sessions               Session[]
  properties             Property[]                    @relation("AgentProperties")
  owners                 Owner[]                       @relation("AgentOwners")
  leads                  Lead[]                        @relation("AgentLeads")
  deals                  Deal[]                        @relation("AgentDeals")
  files                  UploadedFile[]
  conversations          Conversation[]                @relation("UserConversations")
  sentMessages           Message[]                     @relation("SentMessages")
  prospects              Prospect[]
  leadMeetings           LeadMeeting[]                 @relation("AgentMeetings")
  tags                   Tag[]                         @relation("AgentTags")
  // Sprint 1 / MLS parity — Task J9. Properties for which this user is
  // the primary assignee. Separate from `AgentProperties` because a row
  // can be owned by one agent and assigned to another inside the office.
  primaryForProperties   Property[]                    @relation("PrimaryAgent")
  // Sprint 1 / MLS parity — Task D1.
  reminders              Reminder[]                    @relation("AgentReminders")
  // 2026-05-10 — per-(lead, property) activity log rows authored by this agent.
  propertyInterests      PropertyInterest[]            @relation("AgentInterests")
  // 2026-05-10 — per-property owner-side activity log rows authored by this agent.
  ownerActivities        OwnerActivity[]               @relation("AgentOwnerActivities")
  // Excel import — saved column mappings keyed by header signature so
  // repeat imports from the same vendor format auto-apply last choice.
  importMappings         ImportMapping[]
  // Password-reset tokens issued to this user. Rows persist after
  // `usedAt` for auditability; a cron purges >30 day rows.
  passwordResetTokens    PasswordResetToken[]
  reminderAnchors        Reminder[]                    @relation("ReminderCustomer")
  // Sprint 1 / MLS parity — Task K2.
  leadAssignments        LeadAgent[]                   @relation("LeadAssignments")
  // Sprint 5 / MLS parity — Task J10.
  propertyAssignments    PropertyAssignee[]            @relation("PropertyAssigneeUser")
  // 2026-05-03 — per-property external broker contacts owned by this agent.
  propertyBrokers        PropertyBroker[]              @relation("AgentPropertyBrokers")
  // Sprint 6 / MLS parity — Task F1.
  adverts                Advert[]                      @relation("AgentAdverts")
  // Sprint 7 / MLS parity — Tasks B3, B4.
  savedSearches          SavedSearch[]                 @relation("AgentSavedSearches")
  favorites              Favorite[]                    @relation("AgentFavorites")
  // Sprint 1 / MLS parity — Task A1 fill-in. Office invites sent by
  // this user (as OWNER) and accepted by this user (on signup/login).
  officeInvitesSent      OfficeInvite[]                @relation("OfficeInvitesSent")
  officeInvitesAccepted  OfficeInvite[]                @relation("OfficeInvitesAccepted")
  // Sprint 4 — in-app notifications targeted at this user.
  notifications          Notification[]
  // Market Discovery (2026-04-27) — back-relation for matches the
  // hourly watcher creates against this agent's active LeadSearchProfiles.
  marketListingMatches   MarketListingLeadMatch[]
  // Phase 3 — opt-in notification preferences (email/SMS).
  notificationPreference UserNotificationPreference?
  // Phase 3 — pending email/SMS deliveries the worker drains.
  pendingDeliveries      PendingNotificationDelivery[]
  // 2026-05-06 — per-(lead, marketListing) match dispatch ledger.
  // Each row represents one match the digest scheduler may include
  // in its next 30-min email. `dispatchedAt` flips when the row is
  // included in a sent digest, which doubles as the dedup key so
  // the same lead × listing pair is never emailed twice.
  notificationDispatches NotificationDispatch[]
  // Sprint 6 — in-house digital contracts (exclusivity / brokerage /
  // offer) authored by this agent.
  contracts              Contract[]                    @relation("AgentContracts")

  // Sprint 10 — AI usage ledger. Observability only; no quotas yet.
  aiUsage AiUsage[]

  @@index([role])
  @@index([officeId])
}

// ────────────────────────────────────────────────────────────────────
// Sprint 10 — AI usage ledger. One row per Anthropic call (chat /
// describe / voice-ingest / meeting-brief / offer-review / matcher).
// Cost is computed server-side from the model's published prices at
// the time of the call and stored so historic rows don't shift when
// Anthropic changes pricing.
// ────────────────────────────────────────────────────────────────────
model AiUsage {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature           String
  model             String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  cacheReadTokens   Int      @default(0)
  cacheCreateTokens Int      @default(0)
  audioSeconds      Int      @default(0)
  // P0-4 — Decimal not Float. Float aggregates lose precision over
  // millions of rows; billing math needs exact arithmetic. (12,4) gives
  // up to 99,999,999.9999 USD with 0.0001¢ resolution.
  costUsd           Decimal  @default(0) @db.Decimal(12, 4)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model AgentProfile {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency             String?
  title              String?
  license            String?
  bio                String?
  // Formal intake-form header fields.
  personalId         String? // ת.ז. of the agent, printed on the order header
  businessAddress    String? // e.g. "אלון 18א', נס ציונה"
  // Agent's own brokerage-intake legal text — rendered on the public
  // prospect-sign form. Agents paste the exact copy they use on paper
  // (or let product supply a sensible default). HTML so multi-paragraph
  // formatting survives; we sanitize on render.
  brokerageTermsHtml String?
}

model CustomerProfile {
  userId String  @id
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Connects a customer-login to their lead record if one exists
  leadId String? @unique
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?
  ip        String?
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
}

// Sliding-window quota for Yad2 agency-wide imports — each Playwright
// crawl is expensive (60-120s + bot-tax against Yad2's WAF), so each
// agent gets a soft cap of 3 attempts per rolling 60 minutes. Rows are
// pruned when a new attempt is recorded; the table is therefore capped
// at ~3 rows per agent at steady state.
model Yad2ImportAttempt {
  id          String   @id @default(cuid())
  agentId     String
  attemptedAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([agentId, attemptedAt])
}

// ─── Domain ────────────────────────────────────────────────────────────────
model Property {
  id                         String                     @id @default(cuid())
  agentId                    String
  // onDelete: Cascade — when a User is hard-deleted (purgeDeletedUsers
  // worker after the 30d retention window), every Property they owned
  // must go with them. Without the cascade the FK Restrict default
  // blocks the worker's user.delete() call and the privacy promise at
  // /privacy is silently broken (rows live forever).
  agent                      User                       @relation("AgentProperties", fields: [agentId], references: [id], onDelete: Cascade)
  // Per-agent SEO slug — used in /agents/<agent>/<property> URLs.
  slug                       String?
  assetClass                 AssetClass
  category                   PropertyCategory
  status                     PropertyStatus             @default(ACTIVE)
  type                       String // דירה, משרד, חנות, etc.
  street                     String
  city                       String
  lat                        Float?
  lng                        Float?
  // Task 3 — validated structured address. `placeId` is the Photon / OSM id
  // (e.g. "W123", "R456"); `formattedAddress` is the full Hebrew line from
  // the Places provider. Nullable so legacy rows keep rendering from the
  // free-text `street` + `city` until they're re-validated.
  placeId                    String?
  formattedAddress           String?
  // ── Property owner (the seller / landlord) ─────────────────────────────
  // `propertyOwnerId` references the new Owner table — the canonical record.
  // The legacy inline `owner` / `ownerPhone` / `ownerEmail` columns remain
  // as a denormalized copy so older code keeps working during the rollout;
  // they're auto-synced from the Owner row at write-time.
  propertyOwnerId            String?
  propertyOwner              Owner?                     @relation(fields: [propertyOwnerId], references: [id], onDelete: SetNull)
  owner                      String
  ownerPhone                 String
  ownerEmail                 String?
  // 2026-05-03 — optional Israeli national-ID number for the property owner.
  // Optional because most listings are captured before the agent has it; can
  // be filled in later for contracts / due diligence. Stored as plain string
  // (no validation here) to allow non-Israeli IDs (passports) when needed.
  ownerNationalId            String?
  exclusiveStart             DateTime?                  @db.Timestamptz(6)
  exclusiveEnd               DateTime?                  @db.Timestamptz(6)
  marketingPrice             Int
  closingPrice               Int?
  offer                      Int?
  sqm                        Int
  sqmArnona                  Int?
  sqmTabu                    Int?
  sqmGross                   Int? // Commercial: gross area
  sqmNet                     Int? // Commercial: net usable area
  rooms                      Float?
  floor                      Int?
  totalFloors                Int?
  // ── Elevator ────────────────────────────────────────────────
  elevator                   Boolean                    @default(false)
  elevatorCount              Int? // How many elevators in the building
  shabbatElevator            Boolean                    @default(false)
  // ────────────────────────────────────────────────────────────
  renovated                  String?
  buildState                 String? // Commercial: shell (מעטפת) / finished (גמר)
  vacancyDate                String?
  vacancyFlexible            Boolean                    @default(false)
  // ── Parking ─────────────────────────────────────────────────
  parking                    Boolean                    @default(false)
  parkingType                String? // "tabu" | "nearby" | "private"
  parkingCount               Int?
  parkingCovered             Boolean                    @default(false)
  parkingCoupled             Boolean                    @default(false) // צמודות
  parkingTandem              Boolean                    @default(false) // עוקבות
  parkingEvCharger           Boolean                    @default(false)
  nearbyParking              Boolean                    @default(false) // Commercial: public parking nearby
  // 2026-05-03 — Commercial extras pricing. Total = marketingPrice +
  // (parkingPricePerSpot × parkingCount) + storagePrice. Computed in
  // the FE display rather than stored so legacy rows stay untouched.
  parkingPricePerSpot        Int?
  // ── Storage ─────────────────────────────────────────────────
  storage                    Boolean                    @default(false)
  storageLocation            String? // "attached" | "basement"
  storageSize                Int?
  storagePrice               Int?
  // ────────────────────────────────────────────────────────────
  balconySize                Int                        @default(0)
  // 1.1 — sub-option surfaced in the form only when balconySize > 0.
  // Free-form string (not enum) so product can add values without a
  // migration; UI today offers "SUNNY" (שמש) / "COVERED" (מקורה).
  balconyType                String?
  airDirections              String?
  ac                         Boolean                    @default(false)
  safeRoom                   Boolean                    @default(false) // ממ״ד (in-unit)
  floorShelter               Boolean                    @default(false) // מרחב מוגן קומתי (floor-level)
  shelter                    Boolean                    @default(false) // מקלט (building-level)
  buildingAge                Int?
  sector                     String?
  notes                      String?
  // ── Registry / fees ─────────────────────────────────────────
  neighborhood               String?
  gush                       String? // Israeli land registry block
  helka                      String? // Israeli land registry parcel
  arnonaAmount               Int? // Monthly arnona fee (shekel)
  buildingCommittee          Int? // Monthly ועד בית fee
  // ── Commercial-specific amenities ──────────────────────────
  kitchenette                Boolean                    @default(false)
  meetingRoom                Boolean                    @default(false)
  workstations               Int?
  lobbySecurity              Boolean                    @default(false)
  // ── Exclusivity agreement ──────────────────────────────────
  exclusivityAgreementUrl    String? // S3 key or URL to signed PDF
  // 1.3 — explicit "on-market" date, independent of row createdAt so
  // re-listings and import backfills can show the right "days on market".
  // NULL means the property was never marketed (draft). Falls back to
  // createdAt in the UI for legacy rows.
  marketingStartDate         DateTime?                  @db.Timestamptz(6)
  // 3.2 — commercial-only zone tag (e.g. "איזור תעשיה"). Residential
  // rows keep NULL. Free-form string to avoid another migration when
  // product adds more zones.
  commercialZone             String?
  lastContact                DateTime?                  @db.Timestamptz(6)
  lastContactNotes           String?
  marketingReminderFrequency MarketingReminderFrequency @default(WEEKLY)

  // Sprint 3 / MLS parity — Tasks J4–J7. Richer property attributes to
  // reach Nadlan One parity on the listing form. All additive + nullable/
  // defaulted so legacy rows stay valid.
  condition      PropertyCondition?
  heatingTypes   String[]           @default([])
  halfRooms      Int?
  masterBedroom  Boolean            @default(false)
  bathrooms      Int?
  toilets        Int?
  furnished      Boolean            @default(false)
  petFriendly    Boolean            @default(false)
  doormenService Boolean            @default(false)
  gym            Boolean            @default(false)
  pool           Boolean            @default(false)
  gatedCommunity Boolean            @default(false)
  accessibility  Boolean            @default(false)
  utilityRoom    Boolean            @default(false)
  listingSource  String? // e.g. "yad2" | "onmap" | "facebook" | "referral" | "self"

  // Sprint 1 / MLS parity — Task J9. Pipeline stage (see PropertyStage
  // comment), commission %, primary assignee, exclusivity expiry, and
  // seller-side seriousness. `status` stays the life-cycle flag; the
  // two axes are orthogonal.
  stage              PropertyStage? @default(IN_PROGRESS)
  // P0-4 — Decimal not Float. Float % values drift on aggregation.
  agentCommissionPct Decimal?       @db.Decimal(5, 2)
  // Primary assignee ("סוכן מטפל"). Defaults to the row's `agentId`;
  // set explicitly when the office owner reassigns without transferring
  // ownership. Nullable so legacy rows stay clean.
  primaryAgentId     String?
  primaryAgent       User?          @relation("PrimaryAgent", fields: [primaryAgentId], references: [id], onDelete: SetNull)
  exclusivityExpire  DateTime?      @db.Timestamptz(6)
  sellerSeriousness  Seriousness?
  brokerNotes        String?

  // 2026-04-26 — PR2 form additions. Unit/apartment number (display
  // distinguisher when one building has many listings), residential
  // amenities (residents' room, bicycle room, management company),
  // commercial extras (en-suite toilet), and rental-brokerage commission
  // shapes (tenant-side-only flag and free-form terms like "חודש + מע״מ").
  unitNumber         String?
  enSuiteToilet      Boolean @default(false)
  residentsRoom      Boolean @default(false)
  bicycleRoom        Boolean @default(false)
  managementCompany  String?
  tenantSideOnly     Boolean @default(false)
  commissionTerms    String?
  // 2026-04-26 — when the landlord side does pay commission, what does
  // the agent get from them. Free-form so an agent can write "חודש +
  // מע״מ", "2%", "5000 ש״ח", or anything else.
  landlordCommission String?

  // 2026-04-27 — back-relation for the price-offers received on this
  // listing. Hot/active offers + cold/declined ones; PropertyOffer
  // owns the row.
  priceOffers PropertyOffer[]

  // 2026-04-30 — co-broker flag. False (default) = the listing is the
  // agent's own mandate; true = the listing was passed over by another
  // brokerage and this agent is co-listing it. The Properties list and
  // the detail page render co-broker rows with a distinct outline
  // colour so the agent can spot them at a glance.
  coBrokered Boolean @default(false)

  // 2026-04-30 — agent-set priority. Higher values float to the top of
  // /properties so an agent can surface the listings they are actively
  // pushing. Default 0 = no boost.
  priority Int @default(0)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  images           PropertyImage[]
  viewings         PropertyViewing[]
  videos           PropertyVideo[]
  documents        UploadedFile[]
  deal             Deal?
  agreements       Agreement[]
  prospects        Prospect[]
  reminders        Reminder[]
  assignees        PropertyAssignee[]
  // 2026-05-03 — external broker contacts the agent is coordinating with on this listing.
  brokers          PropertyBroker[]
  adverts          Advert[]
  // Sprint 6 — in-house digital contracts attached to this property.
  contracts        Contract[]
  // 2026-05-10 — per-lead "activity log" anchors on this property.
  // Each row is one (lead, property) pair the agent is actively working;
  // all child entities (viewings, offers, agreements, contracts, meetings)
  // optionally point back via `interestId`.
  interests        PropertyInterest[]
  // 2026-05-10 — meetings tagged with this property (showings, in-person
  // negotiations, walkthroughs). Distinct from generic agent meetings.
  meetings         LeadMeeting[]
  // 2026-05-10 — owner-side interaction log (commission talks, price
  // negotiations, owner feedback on specific buyers, marketing approvals,
  // tour permissions, objections). Separate from PropertyInterest which
  // is buyer-side.
  ownerActivities  OwnerActivity[]

  // Excel-import tag. Same purpose as Lead.importBatchId.
  importBatchId   String?
  // Market Discovery (2026-04-27) — when an agent duplicates a
  // discovered listing into their own properties, this column points
  // back to the source MarketListing so the CRM can keep "פתח במקור"
  // available after duplication. Nullable: properties created the
  // normal way have no source.
  marketListingId String?
  marketListing   MarketListing? @relation(fields: [marketListingId], references: [id], onDelete: SetNull)

  @@unique([agentId, slug])
  @@index([agentId])
  // PERF-015 — covers `findMany({ where: { agentId }, orderBy:
  // { createdAt: 'desc' } })` which is the dominant Property query
  // (Properties list, Dashboard, sidebar favorites hydration).
  @@index([agentId, createdAt(sort: Desc)])
  // 2026-05-01 PERF-30user — Properties list orders by [priority desc,
  // createdAt desc] under an agentId filter; without this composite,
  // Postgres falls back to (agentId, createdAt) and sorts by priority
  // in memory. With ~200-row pages that's a 50ms+ cost in the hot path.
  @@index([agentId, priority(sort: Desc), createdAt(sort: Desc)])
  // 2026-05-01 PERF-30user — Dashboard staleProperties query filters
  // by (agentId, status='ACTIVE', updatedAt < cutoff) and orders by
  // updatedAt asc. Dedicated composite avoids a sort step.
  @@index([agentId, status, updatedAt])
  @@index([city])
  @@index([assetClass, category, status])
  @@index([propertyOwnerId])
  @@index([importBatchId])
  @@index([marketListingId])
}

// ────────────────────────────────────────────────────────────────────────────
// Owner — a real person who owns one or more of an agent's listed properties.
//
// Distinct from `Lead` (which represents a CUSTOMER — a prospective buyer or
// renter looking through the agent's listings). One physical human can be
// represented by both an Owner and a Lead row if they wear both hats; that's
// expected and tracked separately so the agent's "ספר בעלים" stays clean.
// ────────────────────────────────────────────────────────────────────────────
model Owner {
  id           String   @id @default(cuid())
  agentId      String
  agent        User     @relation("AgentOwners", fields: [agentId], references: [id], onDelete: Cascade)
  name         String
  // P2-4 — VarChar caps on contact PII.
  phone        String   @db.VarChar(32)
  email        String?  @db.VarChar(255)
  notes        String?
  // Relationship hint, e.g. "בעל יחיד", "ירושה", "חברה". Optional copy.
  relationship String?
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  properties    Property[]
  phones        OwnerPhone[]
  // E-1 — reverse of Deal.seller. One owner can be the seller on many
  // deals (multi-asset portfolios).
  dealsAsSeller Deal[]       @relation("DealSeller")

  @@index([agentId])
  @@index([phone])
}

/// J8 multi-phone. One row per phone number; the legacy `Owner.phone`
/// column above is kept as the denormalized "primary" for back-compat.
model OwnerPhone {
  id        String         @id @default(cuid())
  ownerId   String
  owner     Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // P2-4 — VarChar cap.
  phone     String         @db.VarChar(32)
  kind      OwnerPhoneKind @default(primary)
  label     String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @db.Timestamptz(6)

  @@index([ownerId])
  // P1-1 — "primary phone" lookup hits (ownerId, kind='primary') on
  // every owner detail render.
  @@index([ownerId, kind])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // PERF-005 — variant URLs. `url` stays the canonical full-size
  // (legacy callers read it directly) and the resize pipeline
  // populates the two smaller URLs on new uploads. Both nullable so
  // legacy rows imported before the variants pipeline (or via the
  // Yad2 scrape) keep rendering through the legacy /uploads/* path.
  url        String
  urlCard    String?
  urlThumb   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId])
}

// 2026-04-27 — Price offers received on a property. Captures who
// offered, how much, optional notes (financing, contingencies), the
// status (NEW / NEGOTIATING / ACCEPTED / DECLINED / WITHDRAWN), and
// when. Each row is a single offer event — chained offers from the
// same buyer create separate rows so we keep the negotiation timeline
// intact. Optionally links back to a Lead if the buyer is already in
// the agent's CRM.
model PropertyOffer {
  id         String              @id @default(cuid())
  propertyId String
  property   Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Optional CRM link — when null, the offer captures only the
  // free-form name + phone fields below.
  leadId     String?
  lead       Lead?               @relation(fields: [leadId], references: [id], onDelete: SetNull)
  buyerName  String
  buyerPhone String?
  amount     Int
  status     PropertyOfferStatus @default(NEW)
  // Free-form notes — financing terms, contingencies, "מציע מותנה
  // בקבלת משכנתא", etc. Hebrew-friendly.
  notes      String?
  // When the offer was received. Defaults to row creation but can be
  // overridden when the agent is recording past offers.
  receivedAt DateTime            @default(now()) @db.Timestamptz(6)
  // 2026-05-10 — "relayed amount" supports the Israeli broker
  // negotiation pattern where the agent passes a SHAVED price to the
  // seller (e.g., buyer offered 2.1M, agent relays 2.08M to keep 20K
  // as room for negotiation / margin). `amount` is the buyer's real
  // offer; `relayedAmount` is what the agent communicated to the
  // seller. When relayedAmount is null, the agent passed the offer
  // through as-is.
  relayedAmount Int?
  // ── Threaded buyer↔owner dialog ──────────────────────────────
  // Each offer is one round of the dialog. `direction` flags which
  // side proposed this round so the timeline can render arrows
  // (BUYER_TO_SELLER ▶, SELLER_TO_BUYER ◀ counter-offer).
  // `replyToOfferId` threads counters to their parent so a multi-round
  // negotiation reads as a conversation, not a flat list.
  direction       PropertyOfferDirection @default(BUYER_TO_SELLER)
  replyToOfferId  String?
  replyToOffer    PropertyOffer? @relation("OfferThread", fields: [replyToOfferId], references: [id], onDelete: SetNull)
  replies         PropertyOffer[] @relation("OfferThread")
  // ── Agreed deal terms per round ──────────────────────────────
  // Free-text payment schedule and handover date for THIS particular
  // offer round. Lets each counter-offer carry its own terms; the
  // "winning" offer becomes the deal terms.
  paymentTerms    String?
  handoverNotes   String?
  createdAt  DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(6)
  // 2026-05-10 — back-link to the PropertyInterest activity log row.
  interestId String?
  interest   PropertyInterest? @relation(fields: [interestId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([leadId])
  @@index([interestId])
  @@index([status])
  @@index([receivedAt])
}

enum PropertyOfferStatus {
  NEW
  NEGOTIATING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

// 2026-05-10 — which side of the negotiation triangle proposed this
// particular offer round. The agent sits in the middle and routinely
// relays counter-offers between the two sides; tagging each row makes
// the timeline read as a coherent dialog.
enum PropertyOfferDirection {
  BUYER_TO_SELLER   // buyer's offer (potentially relayed shaved to seller via `relayedAmount`)
  SELLER_TO_BUYER   // seller's counter-offer back to the buyer
}

model PropertyVideo {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String // served via /uploads/videos/... or an external URL
  kind       String   @default("upload") // "upload" | "external" (youtube/vimeo)
  title      String?
  posterUrl  String?
  sizeBytes  Int?
  mimeType   String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([propertyId])
}

model PropertyViewing {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  viewedAt   DateTime @default(now()) @db.Timestamptz(6)
  source     String?
  notes      String?
  // 2026-05-10 — back-link to the PropertyInterest pipeline row that
  // owns this event. Nullable for back-compat with rows created before
  // the activity log existed.
  interestId String?
  interest   PropertyInterest? @relation(fields: [interestId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([leadId])
  @@index([interestId])
}

// 2026-05-10 — per-lead per-property "activity log" anchor. One row per
// (lead, property) pair the agent is actively working. Holds high-level
// status only (בתהליך / נסגר / נפל / מושהה); the timeline of actions
// itself is reconstructed by querying the existing transactional tables
// (PropertyViewing, PropertyOffer, Agreement, Contract, LeadMeeting)
// filtered by interestId.
//
// The lead-property activity model intentionally rejects a linear-stage
// approach. Israeli real-estate flows are routinely non-linear: a serious
// buyer might offer without ever touring, the same lead can tour 4
// listings before offering on one, and MOU/contract negotiation cycles
// can run for months with viewings and offers in parallel. The "stage"
// is just a status flag the agent owns.
model PropertyInterest {
  id          String                 @id @default(cuid())
  agentId     String
  agent       User                   @relation("AgentInterests", fields: [agentId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status      PropertyInterestStatus @default(IN_PROGRESS)
  notes       String?
  // Free-text reason populated when the agent flips to LOST. Used for
  // "why did this fall through?" reporting later.
  lostReason  String?
  // ── Buyer-side commission ─────────────────────────────────────
  // The agent's fee from THIS buyer. Mirror of the owner-side
  // commission lives on OwnerActivity (kind=COMMISSION_TALK) — Israeli
  // brokers routinely charge both sides at different terms.
  //
  // Three modes the agent may use, depending on the deal:
  //   1. Percentage of an agreed base price (the most common):
  //      `buyerCommissionPct` × `buyerCommissionBase`
  //   2. Flat fee (`buyerCommissionFlat` only)
  //   3. % with discount (% × base − `buyerCommissionDiscount`)
  // Frontend uses these three fields to compute + display the final
  // amount. All optional so the row works even before commission is
  // pinned down.
  buyerCommissionPct      Float?
  buyerCommissionBase     Int?    // ₪ — what the % applies to
  buyerCommissionFlat     Int?    // ₪ — alternative flat fee
  buyerCommissionDiscount Int?    // ₪ — optional reduction
  buyerCommissionNotes    String?
  // ── Agreed deal terms ────────────────────────────────────────
  // Free-form text where the agent records what the parties have
  // agreed on outside of the structured offer amount: payment
  // schedule ("60% on signature, 35% in 30d, 5% on handover"),
  // handover date ("מועד מסירה 1.9.2026"), any other shared
  // condition. Acts as the "what's the deal we're converging on"
  // memo, visible only to the agent.
  dealNotes               String?
  // Server-bumped whenever a child action (viewing/offer/agreement/meeting)
  // is added with this interestId, so the panel can sort by "recent".
  lastActionAt DateTime?              @db.Timestamptz(6)
  createdAt   DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime               @updatedAt @db.Timestamptz(6)

  // Back-relations to child action tables (all rows are linked through
  // their own interestId column).
  viewings    PropertyViewing[]
  offers      PropertyOffer[]
  agreements  Agreement[]
  contracts   Contract[]
  meetings    LeadMeeting[]

  // Exactly one interest row per (property, lead) pair. Agent can detach
  // (DELETE) and re-create if they want a clean slate.
  @@unique([propertyId, leadId])
  @@index([agentId])
  @@index([propertyId, status])
  @@index([leadId, status])
  @@index([lastActionAt])
}

enum PropertyInterestStatus {
  IN_PROGRESS  // בתהליך — default
  CLOSED       // נסגר   — deal completed
  FELL         // נפל    — fell through
  PAUSED       // מושהה  — on hold
}

// 2026-05-10 — Owner-side interaction log for a listing. Each row is
// one conversation/event the agent had with the property owner about
// this specific listing. Captures the things an Israeli broker
// routinely tracks: commission % discussions, owner feedback on
// specific buyers, price negotiations, tour permissions, marketing
// approvals, objections, MOU/contract talks.
//
// Separate from PropertyInterest because the owner is conceptually a
// different counterparty — there's one owner per listing, but many
// buyer-side interests, and the kinds of interactions are different.
model OwnerActivity {
  id            String   @id @default(cuid())
  agentId       String
  agent         User     @relation("AgentOwnerActivities", fields: [agentId], references: [id], onDelete: Cascade)
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind          OwnerActivityKind
  // Short summary line the agent types ("הצעתי 2%", "לא יורד מ-3M").
  title         String
  // Free-form longer notes — what the owner said, agent's reactions,
  // follow-up needed.
  notes         String?
  // ── Commission-talk-specific fields ──────────────────────────
  // Only populated when kind=COMMISSION_TALK. Captures BOTH percentage
  // (e.g., 2%) AND flat-fee (e.g., ₪40,000) variants — Israeli brokers
  // commonly quote one or the other. The agent fills whichever matches
  // the conversation that happened.
  commissionPct      Float?
  commissionFlat     Int?     // ₪
  commissionResponse OwnerCommissionResponse?
  // ── Lead cross-reference ─────────────────────────────────────
  // For kinds where the conversation was *about* a specific buyer
  // (FEEDBACK_ON_LEAD, OBJECTION raised against a buyer, PRICE_TALK
  // tied to a specific offer). SetNull so deleting the lead doesn't
  // delete the historical record of what was said about them.
  relatedLeadId String?
  relatedLead   Lead?    @relation("OwnerActivityRelatedLead", fields: [relatedLeadId], references: [id], onDelete: SetNull)
  // When the conversation happened. Defaults to now() but the agent
  // can override when logging a past conversation.
  occurredAt    DateTime @default(now()) @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@index([agentId])
  @@index([propertyId])
  @@index([propertyId, occurredAt(sort: Desc)])
  @@index([relatedLeadId])
}

enum OwnerActivityKind {
  COMMISSION_TALK    // שיחת עמלה
  PRICE_TALK         // שיחת מחיר
  FEEDBACK_ON_LEAD   // משוב על מתעניין
  TOUR_PERMISSION    // אישור סיור
  MARKETING_UPDATE   // עדכון שיווק
  OBJECTION          // התנגדות
  CONTRACT_TALK      // שיחת הסכם
  GENERAL_UPDATE     // עדכון כללי
  OTHER              // אחר
}

enum OwnerCommissionResponse {
  PENDING            // ממתין לתשובה
  ACCEPTED           // התקבל
  COUNTER            // הצעה נגדית
  REJECTED           // נדחה
}

model Lead {
  id                      String           @id @default(cuid())
  agentId                 String
  // onDelete: Cascade — same rationale as Property.agent above.
  // The 30d-retention purge worker depends on every owned-by-agent
  // model cascading on User.delete().
  agent                   User             @relation("AgentLeads", fields: [agentId], references: [id], onDelete: Cascade)
  name                    String
  // P2-4 — VarChar caps on contact PII.
  phone                   String           @db.VarChar(32)
  email                   String?          @db.VarChar(255)
  interestType            LeadInterestType @default(PRIVATE)
  lookingFor              LeadLookingFor   @default(BUY)
  // 2026-04-30 — distinguishes ליד מתעניין (BUYER) from ליד גיוס
  // (SELLER). For SELLER rows the city/neighborhood/street/rooms/budget
  // describe the property the agent wants to recruit, not the lead's
  // criteria — same columns, opposite reading. Default BUYER keeps
  // the legacy semantics for every existing row.
  kind                    LeadKind         @default(BUYER)
  city                    String?
  neighborhood            String?
  street                  String?
  rooms                   String?
  priceRangeLabel         String?
  budget                  Int?
  preApproval             Boolean          @default(false)
  sector                  String?
  balconyRequired         Boolean          @default(false)
  parkingRequired         Boolean          @default(false)
  elevatorRequired        Boolean          @default(false)
  safeRoomRequired        Boolean          @default(false)
  acRequired              Boolean          @default(false)
  storageRequired         Boolean          @default(false)
  // Commercial-lead requirement block — mirrors the commercial half
  // of the Property schema. Agents capture these when a business
  // client briefs a brokerage for office / shop / workspace space
  // ("need ≥60 מ"ר ברוטו, shell finish, 3 workstations, kitchenette,
  // ממ"ק, accessibility"). All optional — private-home leads leave
  // them empty.
  sqmGrossMin             Int?
  sqmNetMin               Int?
  accessibilityRequired   Boolean          @default(false)
  buildStateRequired      String? // "מעטפת" / "גמר" / specific finish
  workstationsMin         Int? // מספר עמדות עבודה
  kitchenetteRequired     Boolean          @default(false)
  floorShelterRequired    Boolean          @default(false) // ממ"ק
  inOfficeToiletsRequired Boolean          @default(false) // שירותים בתוך המשרד
  onFloorToiletsRequired  Boolean          @default(false) // שירותים משותפים בקומה
  openSpaceRequired       Boolean          @default(false) // חלל פתוח
  schoolProximity         String?
  // 2026-05-08 — additional brief requirements surfaced on the lead form.
  // Both are agent-side signals (the matching pipeline can prefer
  // properties walkable to schools / transit). Defaults false keep
  // existing rows unaffected.
  educationProximityRequired Boolean       @default(false)
  publicTransportRequired    Boolean       @default(false)
  // 2026-05-08 PR 2 — multi-value brief fields. The single-value
  // `city` / `neighborhood` columns above stay for back-compat (the
  // matching pipeline + leadSearchProfileSeed still read them) and the
  // route writes cities[0] → city / neighborhoods[0] → neighborhood
  // on save. UI binds to the arrays.
  cities                     String[]      @default([])
  neighborhoods              String[]      @default([])
  streets                    String[]      @default([])
  propertyTypes              String[]      @default([])
  floorMin                   Int?
  floorMax                   Int?
  sqmMin                     Int?
  sqmMax                     Int?
  source                  String?
  // `status` is the thermal temperature rating (HOT/WARM/COLD). New in
  // Sprint 1 / MLS parity Task K2: `customerStatus` is the separate
  // life-cycle flag (אקטואלי / לא אקטואלי / etc.). Kept orthogonal.
  status                  LeadStatus       @default(WARM)
  notes                   String?
  brokerageSignedAt       DateTime?        @db.Timestamptz(6)
  brokerageExpiresAt      DateTime?        @db.Timestamptz(6)
  lastContact             DateTime?        @db.Timestamptz(6)

  // Sprint 1 / MLS parity — Task K2. Customer admin block.
  customerStatus      CustomerStatus?
  // P0-4 — Decimal not Float (see AiUsage.costUsd / Property.agentCommissionPct).
  commissionPct       Decimal?          @db.Decimal(5, 2)
  isPrivate           Boolean           @default(false)
  purposes            CustomerPurpose[] @default([])
  seriousnessOverride Seriousness?

  // Sprint 2 / MLS parity — Task K1. Richer contact + identity fields
  // mirroring the Nadlan customer form. Existing `name` / `phone` /
  // `email` stay as primary/display values; these are the expanded
  // variants so import/export and power-user flows don't lose data.
  firstName    String?
  lastName     String?
  companyName  String?
  address      String?
  cityText     String?
  zip          String?
  // P2-4 — VarChar caps on phone fields.
  primaryPhone String?          @db.VarChar(32)
  phone1       String?          @db.VarChar(32)
  phone2       String?          @db.VarChar(32)
  fax          String?
  personalId   String?
  // Sprint 2 / MLS parity — Task L3 placeholder. Quick-lead UI uses
  // the shorter single-line `description`; the longer `notes` stays.
  description  String?
  // Sprint 2 / MLS parity — Task L1. Quick-lead lifecycle status.
  leadStatus   QuickLeadStatus? @default(NEW)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  viewings        PropertyViewing[]
  customerProfile CustomerProfile?
  agreements      Agreement[]
  meetings        LeadMeeting[]
  reminders       Reminder[]
  // Sprint 1 / MLS parity — Task K2. Additional assignees. Primary
  // assignee stays `agentId` on Lead; the join table lets the office
  // share a lead across multiple agents.
  extraAgents     LeadAgent[]
  // Sprint 2 / MLS parity — Task K4. Repeatable "הנכס המבוקש" profiles.
  searchProfiles  LeadSearchProfile[]
  // Reverse of Prospect.lead — signed prospects linked to this lead.
  prospects       Prospect[]
  // E-1 — reverse of Deal.buyer. A lead can be tied to multiple deals
  // across their history (repeat buyers / combined transactions).
  dealsAsBuyer    Deal[]              @relation("DealBuyer")
  // Sprint 6 — in-house digital contracts tied to this lead.
  contracts       Contract[]
  // 2026-04-27 — back-relation for PropertyOffer.lead. When a lead
  // makes an offer on a listing the row is captured here too so the
  // CRM can show "all offers from X" across properties.
  priceOffers     PropertyOffer[]
  // 2026-05-10 — properties this lead is being shown / negotiated for.
  interests       PropertyInterest[]
  // 2026-05-10 — back-rel for owner-activity rows that reference this
  // lead ("owner said X about buyer Y").
  ownerActivityMentions OwnerActivity[]        @relation("OwnerActivityRelatedLead")

  // Excel-import tag. Set on every Lead row created via the wizard so
  // an agent who realises the mapping was wrong can bulk-delete the
  // batch from the list page.
  importBatchId        String?
  // PERF-015 — same rationale as Property: the leads list /
  // Customers page sorts by createdAt desc inside an agent scope.
  // Market Discovery (2026-04-27) — back-relation for hourly-watcher
  // matches against this lead's LeadSearchProfile rows.
  marketListingMatches MarketListingLeadMatch[]

  @@index([agentId])
  @@index([agentId, createdAt(sort: Desc)])
  @@index([status])
  @@index([customerStatus])
  @@index([city])
  @@index([importBatchId])
  // P1-2 — agent-scoped status filters. The leads list filters by
  // status/customerStatus inside an agent scope on every render; a
  // single-column status index forces a bitmap merge with agentId.
  @@index([agentId, status])
  @@index([agentId, customerStatus])
}

// Sprint 1 / MLS parity — Task K2. Composite-PK join table for
// multi-agent lead assignment.
model LeadAgent {
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId    String
  agent      User     @relation("LeadAssignments", fields: [agentId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([leadId, agentId])
  @@index([agentId])
}

model Deal {
  id             String           @id @default(cuid())
  agentId        String
  // P0-5 — Cascade on agent delete. Deal rows are agent-owned business
  // records; the privacy-policy purge already removes the User after
  // 30 days, and we want their deals to follow.
  agent          User             @relation("AgentDeals", fields: [agentId], references: [id], onDelete: Cascade)
  propertyId     String?          @unique
  property       Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  propertyStreet String
  city           String
  assetClass     AssetClass
  category       PropertyCategory
  status         DealStatus       @default(NEGOTIATING)
  marketingPrice Int
  offer          Int?
  closedPrice    Int?
  commission     Int?
  buyerAgent     String?
  sellerAgent    String?
  lawyer         String?
  updateDate     DateTime         @default(now()) @db.Timestamptz(6)
  signedAt       DateTime?        @db.Timestamptz(6)
  // E-1 — structured parties. `buyerId` references a Lead (the
  // prospective buyer in the CRM), `sellerId` references an Owner
  // (the canonical seller record). Both nullable — legacy rows and
  // quickly-captured deals may only have the free-text
  // buyerAgent/sellerAgent copy. `closeDate` is the target / actual
  // closing date (distinct from `signedAt` which is the binding-
  // contract signature date).
  buyerId        String?
  buyer          Lead?            @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  sellerId       String?
  seller         Owner?           @relation("DealSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  closeDate      DateTime?        @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(6)

  @@index([agentId])
  @@index([status])
  @@index([buyerId])
  @@index([sellerId])
}

model Agreement {
  id          String          @id @default(cuid())
  leadId      String?
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyId  String?
  property    Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  signerName  String
  signerPhone String?
  signerEmail String?
  fileId      String?
  // P0-5 — SetNull on file delete. The Agreement row holds the audit
  // trail (signer, sentAt, signedAt); losing the PDF doesn't invalidate
  // the record, but a dangling FK to a vanished UploadedFile would.
  file        UploadedFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  sentAt      DateTime        @default(now()) @db.Timestamptz(6)
  signedAt    DateTime?       @db.Timestamptz(6)
  status      AgreementStatus @default(SENT)
  note        String?
  // 2026-05-10 — back-link to the PropertyInterest activity log row.
  interestId  String?
  interest    PropertyInterest? @relation(fields: [interestId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([propertyId])
  @@index([interestId])
}

model UploadedFile {
  id           String           @id @default(cuid())
  ownerId      String
  owner        User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  kind         UploadedFileKind
  originalName String
  mimeType     String
  sizeBytes    Int
  path         String // relative path on disk inside /uploads (S3 key in prod)
  // Sprint 6 — Documents library. Free-form user labels (e.g. "חוזים",
  // "סקרים") for the /documents page filter pill row. Empty array by
  // default; legacy rows (property images / signed agreements) never
  // populate it.
  tags         String[]         @default([])
  // 2026-04-27 — optional scoping to a specific property so the agent
  // can attach a PDF (e.g. exclusivity agreement, building plan,
  // arnona statement) directly to a listing. Nullable so existing
  // rows + the global /documents page keep working unchanged.
  propertyId   String?
  property     Property?        @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)

  agreements Agreement[]

  // P2-5 — single-column @@index([ownerId]) was redundant; the
  // compound (ownerId, kind) below already serves any query that
  // filters by ownerId alone (left-prefix rule).
  @@index([kind])
  @@index([ownerId, kind])
  @@index([propertyId])
}

model CityLookup {
  name String @id
  lat  Float
  lng  Float
}

model StreetLookup {
  id   String @id @default(cuid())
  name String
  city String
  lat  Float
  lng  Float

  @@unique([name, city])
  @@index([city])
}

// 1.5 — Prospect intake form, per-property. Collected either in-person
// (canvas signature pad) or via a shareable short-lived public link
// (publicToken + tokenExpiresAt) that lands the prospect on a kiosk-
// style page they can sign on their own phone.
//
// Why a dedicated table instead of reusing Lead? A prospect is not
// necessarily a CRM-tracked customer — they might just be interested
// in this one property. Conversion "prospect → lead" is an explicit
// agent decision, not an auto-consequence of filling the form.
model Prospect {
  id               String    @id @default(cuid())
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId          String
  agent            User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name             String
  phone            String?
  email            String?
  source           String?
  notes            String?
  // Data-URL of the rendered signature strokes. Small (a few KB PNG)
  // and self-contained — no extra storage backend required. Nullable
  // for the digital flow where the prospect signs later.
  signatureDataUrl String?
  signedAt         DateTime? @db.Timestamptz(6)
  // Identity fields captured on the public sign form (industry-standard
  // interested-party intake). Nullable because legacy rows pre-date these.
  idType           String? // 'ID' (Israeli ת.ז.) | 'PASSPORT'
  idNumber         String?
  address          String?
  // Public sign-from-phone flow tokens.
  publicToken      String?   @unique
  tokenExpiresAt   DateTime? @db.Timestamptz(6)
  // Optional link to an existing Lead in the agent's CRM. Set either
  // by the auto-link heuristic on signing (exact-one phone/email
  // match under the same agent) or manually from PropertyDetail.
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  // Per-agent sequential order number printed on the brokerage-services
  // agreement PDF. Back-filled for legacy rows by the migration.
  orderNumber      Int?
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([agentId, orderNumber])
  @@index([propertyId])
  @@index([agentId])
  @@index([leadId])
}

// 7.2 — Meetings scheduled with a lead, optionally mirrored to the
// agent's Google Calendar. googleEventId ties the two so subsequent
// edits / deletes propagate.
model LeadMeeting {
  id            String   @id @default(cuid())
  // Sprint 4.1 — leadId is nullable so the /calendar "פגישה חדשה" CTA
  // can create agent-only events (no lead linked). The relation drops
  // to SetNull on lead delete so removing a lead leaves the agent's
  // meeting record alone rather than cascading it away.
  leadId        String?
  lead          Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agentId       String
  agent         User     @relation("AgentMeetings", fields: [agentId], references: [id], onDelete: Cascade)
  title         String
  notes         String?
  location      String?
  meetLink      String?
  startsAt      DateTime @db.Timestamptz(6)
  endsAt        DateTime @db.Timestamptz(6)
  googleEventId String?
  // 2026-05-08 — parallel field for Microsoft Graph events when the
  // agent's Outlook integration is on. Either or both can be populated
  // depending on which calendars the agent has connected.
  outlookEventId String?
  // Sprint 5 / AI — voice summariser. `audioKey` is the storage key of
  // the uploaded voice note (S3 path in prod; `local://tmp/<uuid>.webm`
  // when S3 was unreachable during tests). `summary` holds the Hebrew
  // prose for quick rendering; `summaryJson` holds the structured payload
  // `{ summary, actionItems, nextSteps }` consumed by the meeting card.
  audioKey      String?
  summary       String?
  summaryJson   Json?
  // 2026-05-10 — propertyId + interestId. Lets a meeting be a
  // "property showing" (sale tour for a specific listing) instead of a
  // generic agent meeting. Both nullable for back-compat.
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  interestId    String?
  interest      PropertyInterest? @relation(fields: [interestId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @db.Timestamptz(6)

  @@index([leadId])
  @@index([agentId])
  @@index([startsAt])
  @@index([propertyId])
  @@index([interestId])
  // P1-2 — agent calendar view scans (agentId, startsAt) on a date range.
  @@index([agentId, startsAt])
}

// ─── Tags ──────────────────────────────────────────────────────────────────
// Sprint 1 / MLS parity — Task A2. Nadlan calls these "מדבקות" (stickers /
// labels). A single `Tag` can target properties, leads, customers, or any
// mix (via `scope`). `TagAssignment` is a per-entity attach-point so we
// don't have to add a FK on every model. Join is manually-keyed rather
// than using a polymorphic column trick — keeps Prisma queries simple.
enum TagScope {
  PROPERTY
  LEAD
  CUSTOMER
  ALL
}

enum TagEntity {
  PROPERTY
  LEAD
  CUSTOMER
}

model Tag {
  id        String   @id @default(cuid())
  agentId   String
  agent     User     @relation("AgentTags", fields: [agentId], references: [id], onDelete: Cascade)
  name      String
  // Stored as a 7-char hex string (e.g. "#C9A14B"). No enum — callers
  // pick from the design-system palette client-side.
  color     String   @default("#C9A14B")
  scope     TagScope @default(ALL)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  assignments TagAssignment[]

  @@unique([agentId, name])
  @@index([agentId, scope])
}

model TagAssignment {
  id         String    @id @default(cuid())
  tagId      String
  tag        Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType TagEntity
  entityId   String
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

// Sprint 1 / MLS parity — Task D1. Standalone reminder. The dashboard
// merges these with LeadMeetings for the "מתוכננות/ארכיון" panel.
model Reminder {
  id          String         @id @default(cuid())
  agentId     String
  agent       User           @relation("AgentReminders", fields: [agentId], references: [id], onDelete: Cascade)
  title       String
  notes       String?
  dueAt       DateTime       @db.Timestamptz(6)
  status      ReminderStatus @default(PENDING)
  completedAt DateTime?      @db.Timestamptz(6)
  cancelledAt DateTime?      @db.Timestamptz(6)
  // Set by the reminderScheduler worker once the bell + email
  // have been emitted for this reminder. Prevents double-firing on
  // every poll. NULL means "not notified yet"; once set, the worker
  // skips the row regardless of dueAt.
  notifiedAt  DateTime?      @db.Timestamptz(6)

  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  // A `customerId` here is a User id (the customer-side login). Most
  // reminders anchor to a lead instead; this is for the rarer case of a
  // reminder tied to a confirmed customer.
  customerId String?
  customer   User?     @relation("ReminderCustomer", fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([agentId, status, dueAt])
  @@index([leadId])
  @@index([propertyId])
  @@index([customerId])
}

// Sprint 7 / MLS parity — Task G1. Canonical city+neighborhood
// lookup. Properties keep storing the free-text `neighborhood` column
// for back-compat; this table is the dictionary that powers
// autocomplete and hygiene. Aliases capture historical spellings
// (e.g. רמת-אביב vs רמת אביב) without a migration per variant.
model Neighborhood {
  id          String   @id @default(cuid())
  city        String
  name        String
  aliases     String[] @default([])
  // 2026-04-30 — registry street codes that fall inside this
  // neighborhood (per OSM polygons + nearest-neighbor fallback). Built
  // offline via `scripts/build-neighborhood-streets.ts`. Used by the
  // street-autocomplete endpoint to narrow results when the agent
  // has picked a neighborhood for a lead.
  streetCodes Int[]    @default([])
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  // Sprint 7 / MLS parity — Task G2. Reverse relation so cascading
  // deletes on a Neighborhood clean up the join rows automatically.
  groupMemberships NeighborhoodGroupMember[]

  @@unique([city, name])
  @@index([city])
}

// Sprint 7 / MLS parity — Task G2. Marketable-area grouping over the
// flat G1 dictionary. Nadlan One surfaces umbrella areas (e.g.
// "צפון ישן תל אביב") that agents actually discuss in person, and
// those groupings don't live in any OSM-style source. OWNERs curate
// them manually; agents consume them read-only.
model NeighborhoodGroup {
  id          String                    @id @default(cuid())
  city        String
  name        String
  description String?
  aliases     String[]                  @default([])
  members     NeighborhoodGroupMember[]
  createdAt   DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(6)

  @@unique([city, name])
  @@index([city])
}

model NeighborhoodGroupMember {
  groupId        String
  neighborhoodId String
  sortOrder      Int               @default(0)
  group          NeighborhoodGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  neighborhood   Neighborhood      @relation(fields: [neighborhoodId], references: [id], onDelete: Cascade)

  @@id([groupId, neighborhoodId])
  @@index([neighborhoodId])
}

// Sprint 7 / MLS parity — Task B3. Named filter snapshots.
enum SavedSearchEntity {
  PROPERTY
  LEAD
}

model SavedSearch {
  id         String            @id @default(cuid())
  agentId    String
  agent      User              @relation("AgentSavedSearches", fields: [agentId], references: [id], onDelete: Cascade)
  entityType SavedSearchEntity
  name       String
  filters    Json
  createdAt  DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(6)

  @@index([agentId])
}

// Sprint 7 / MLS parity — Task B4. Cross-entity pinboard.
enum FavoriteEntity {
  PROPERTY
  LEAD
  OWNER
}

model Favorite {
  id         String         @id @default(cuid())
  agentId    String
  agent      User           @relation("AgentFavorites", fields: [agentId], references: [id], onDelete: Cascade)
  entityType FavoriteEntity
  entityId   String
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)

  @@unique([agentId, entityType, entityId])
}

// Sprint 6 / MLS parity — Task F1. Per-channel marketing advert
// ("פרסום") for a property. Advert tracks what copy was pushed to
// each channel (Yad2/Facebook/Onmap…) so agents can tweak titles and
// prices independently per outlet.
enum AdvertChannel {
  YAD2
  ONMAP
  MADLAN
  FACEBOOK
  WHATSAPP
  INSTAGRAM
  WEBSITE
  OTHER
}

enum AdvertStatus {
  DRAFT
  PUBLISHED
  PAUSED
  EXPIRED
  REMOVED
}

model Advert {
  id             String        @id @default(cuid())
  agentId        String
  agent          User          @relation("AgentAdverts", fields: [agentId], references: [id], onDelete: Cascade)
  propertyId     String
  property       Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  channel        AdvertChannel
  status         AdvertStatus  @default(DRAFT)
  title          String?
  body           String?
  publishedPrice Int?
  externalUrl    String?
  externalId     String?
  publishedAt    DateTime?     @db.Timestamptz(6)
  expiresAt      DateTime?     @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  @@index([agentId])
  @@index([propertyId])
  @@index([channel, status])
  // P1-2 — Yad2 dashboard filters by (agentId, channel, status).
  @@index([agentId, channel, status])
}

// Sprint 5 / MLS parity — Task J10. Secondary assignees on a
// property. `agentId` on Property stays the canonical owner (used
// for scoping); this join table lets additional agents collaborate.
model PropertyAssignee {
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("PropertyAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  role       String   @default("CO_AGENT")
  assignedAt DateTime @default(now()) @db.Timestamptz(6)

  @@id([propertyId, userId])
  @@index([userId])
}

// 2026-05-03 — per-property broker/colleague contacts. Independent of the
// `User`-based PropertyAssignee table (which links Estia agents who share
// the listing). PropertyBroker is for *external* brokers / colleagues —
// people the agent is coordinating with on this specific property who do
// not have an Estia account. Cascade on property delete: if the asset is
// gone, its private broker list goes with it.
model PropertyBroker {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agentId    String
  agent      User     @relation("AgentPropertyBrokers", fields: [agentId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  agency     String?
  expertise  String?
  notes      String?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([propertyId])
  @@index([agentId])
}

// Sprint 5 / MLS parity — Task H3. Agent-scoped activity log. Records
// who did what to which entity so the UI can render a recent-activity
// timeline and office owners can audit their agents' moves. FKs are
// deliberately weak (no onDelete) — the log should outlive row
// deletion for audit purposes.
model ActivityLog {
  id         String   @id @default(cuid())
  agentId    String
  actorId    String?
  verb       String
  entityType String
  entityId   String?
  summary    String?
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([agentId, createdAt])
  @@index([entityType, entityId])
}

// Sprint 2 / MLS parity — Task K4. Repeatable "הנכס המבוקש" profile on
// a lead. A lead can have multiple profiles (e.g. one for a residence
// in Tel Aviv, another for an investment in Haifa) so matching hits
// all of them. The flat single-value criteria fields on Lead
// (`rooms`, `budget`, `city`, `sector`, the *Required booleans) stay
// for back-compat during rollout.
model LeadSearchProfile {
  id             String            @id @default(cuid())
  leadId         String
  lead           Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Optional user-facing label like "השקעה בתל אביב".
  label          String?
  domain         AssetClass?
  dealType       PropertyCategory?
  // PG text arrays keep the form wiring simple; frontend sends each as
  // a multi-select and backend stores without extra join tables.
  propertyTypes  String[]          @default([])
  cities         String[]          @default([])
  neighborhoods  String[]          @default([])
  streets        String[]          @default([])
  minRoom        Float?
  maxRoom        Float?
  minPrice       Int?
  maxPrice       Int?
  minPricePerSqm Int?
  maxPricePerSqm Int?
  minFloor       Int?
  maxFloor       Int?
  minBuilt       Int?
  maxBuilt       Int?
  minPlot        Int?
  maxPlot        Int?
  parkingReq     Boolean           @default(false)
  elevatorReq    Boolean           @default(false)
  balconyReq     Boolean           @default(false)
  furnitureReq   Boolean           @default(false)
  mamadReq       Boolean           @default(false)
  storeroomReq   Boolean           @default(false)
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  @@index([leadId])
}

// Market-context snapshot fetched from nadlan.gov.il (purchase or
// rent). Keyed by (cityKey, streetKey, kind) so multiple properties on
// the same street share one cache row. 24h TTL is enforced in the
// service layer, not the DB.
model MarketContext {
  id        String            @id @default(cuid())
  cityKey   String
  streetKey String
  kind      MarketContextKind
  fetchedAt DateTime          @default(now()) @db.Timestamptz(6)
  dealCount Int               @default(0)
  payload   Json
  error     String?

  @@unique([cityKey, streetKey, kind])
  @@index([fetchedAt])
}

// ────────────────────────────────────────────────────────────────────
// ImportMapping — saved column mapping per (agent, entityType, header
// signature). When the wizard detects the same header shape an agent
// uploaded before, we pre-apply their last choice so repeat imports
// from the same vendor export need zero clicks in the mapping step.
//
// `headerSig` is a hash of the normalized header row (lowercased,
// trimmed, sorted). `mapping` is `{ [header]: estiaField | 'skip' }`.
// ────────────────────────────────────────────────────────────────────
model ImportMapping {
  id         String   @id @default(cuid())
  agentId    String
  agent      User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  entityType String // "LEAD" | "PROPERTY"
  headerSig  String
  mapping    Json
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@unique([agentId, entityType, headerSig])
  @@index([agentId])
}

// ────────────────────────────────────────────────────────────────────
// PasswordResetToken — single-use password reset tokens.
// Minted by POST /auth/forgot-password, consumed by
// POST /auth/reset-password. Expires after 30 minutes; `usedAt`
// flips on consume so tokens cannot be replayed.
// ────────────────────────────────────────────────────────────────────
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
}

// ────────────────────────────────────────────────────────────────────
// Notification — Sprint 4. In-app notification rows targeted at a
// single user. `type` is a free-form string (e.g. "reminder_due",
// "lead_assigned") that the frontend maps to an icon/color. `body`
// and `link` are optional: a notification can stand on a title alone
// ("תזכורת הושלמה"), or include a longer body and a deep link into
// the app. `readAt` flips from NULL to a timestamp when the user
// dismisses it. Composite indexes optimize the two hot-path queries:
// list ordered by createdAt and unread-count filtered by readAt.
// ────────────────────────────────────────────────────────────────────
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

// ────────────────────────────────────────────────────────────────────
// Sprint 6 — In-house digital contract e-sign flow. Supersedes the
// third-party `Agreement` model path (which is still used for legacy
// DocuSign-style "upload the signed PDF" captures). Contracts are
// rendered + signed via the in-house pdfkit path reused from
// prospect-pdf; no external vendor.
//
// `type` differentiates the four contract flavors an agent sends:
//   BROKERAGE        — seller's non-exclusive brokerage-services order
//                      (הזמנת שירותי תיווך)
//   EXCLUSIVITY      — seller's exclusive listing addendum that
//                      supplements a BROKERAGE order; references the
//                      underlying BROKERAGE via `baseContractId`
//   BUYER_BROKERAGE  — buyer's brokerage-services order over a
//                      captured list of properties (`propertiesSnapshot`)
//   OFFER            — buyer's price offer against a listing
//
// `body` is free-form Hebrew legal text the agent can customise per
// contract (falls back to a sensible default in the route). Once
// `signedAt` is set, the record is locked: further sign attempts 409.
// `signatureName` is the typed-to-sign value from the v1 UI; canvas
// drawing can be layered later without a migration.
// ────────────────────────────────────────────────────────────────────
model Contract {
  id            String    @id @default(cuid())
  agentId       String
  agent         User      @relation("AgentContracts", fields: [agentId], references: [id], onDelete: Cascade)
  propertyId    String?
  property      Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  leadId        String?
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  type          String // 'BROKERAGE' | 'EXCLUSIVITY' | 'BUYER_BROKERAGE' | 'OFFER'
  title         String
  body          String // the contract text rendered into the PDF
  // BUYER_BROKERAGE — snapshot of the property list captured at create
  // time so later edits to the underlying Property rows don't mutate
  // the signed PDF. Array of:
  //   { propertyId?, address, city, rooms?, sqm?, marketingPrice?, kind? }
  propertiesSnapshot Json?
  // EXCLUSIVITY — self-FK to the BROKERAGE order this exclusivity
  // addendum supplements. NULL for the other three types. SetNull on
  // delete so removing the base order doesn't cascade-kill the signed
  // exclusivity row.
  baseContractId String?
  baseContract   Contract?  @relation("ContractBase", fields: [baseContractId], references: [id], onDelete: SetNull)
  baseFor        Contract[] @relation("ContractBase")
  signerName    String
  signerPhone   String?
  signerEmail   String?
  // Sign-time fields: populated when the signer submits. `signatureHash`
  // is a SHA-256 of (contractId + signerName + signedAt.toISOString())
  // — printed on the signed-lock badge as tamper-evidence.
  signedAt      DateTime? @db.Timestamptz(6)
  signatureName String? // the typed-to-sign text
  signatureHash String?
  // 2026-05-03 — chain-of-custody fields for tier-2 admissibility under
  // חוק חתימה אלקטרונית, התשס"א-2001. All nullable: legacy rows stay valid.
  // `documentHash` is SHA-256 of body+title at sign time and is the
  // canonical tamper-evidence — a post-signing edit to `body` no longer
  // matches this hash. `signedIp` / `signedUserAgent` capture the device
  // fingerprint at the moment of signing. `consentText` snapshots the
  // exact consent paragraph the signer was shown (so we can prove what
  // they accepted, even if the wording changes later); `consentAcceptedAt`
  // is set when the signer checks the consent box.
  documentHash       String?
  signedIp           String?
  signedUserAgent    String?
  consentText        String?
  consentAcceptedAt  DateTime? @db.Timestamptz(6)
  // 2026-06-02 — public sign-by-link surface. The agent shares
  // `/contracts/sign/:publicSignToken` with the customer; the customer
  // reviews the contract + signs without logging in. Token is a 24-byte
  // url-safe hex string, expires 30 days after create. `signatureImage`
  // holds the customer's hand-drawn signature as a PNG data-URL (size-
  // capped to 200KB at the route layer) — rendered above the typed name
  // on the signed PDF when present.
  publicSignToken          String?   @unique
  publicSignTokenExpiresAt DateTime? @db.Timestamptz(6)
  signatureImage           String?
  // 2026-05-10 — back-link to the PropertyInterest activity log row.
  interestId    String?
  interest      PropertyInterest? @relation(fields: [interestId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  @@index([agentId])
  @@index([propertyId])
  @@index([leadId])
  @@index([interestId])
  @@index([type])
  @@index([baseContractId])
}

// ────────────────────────────────────────────────────────────────────
// Market Discovery — Phase 1 (2026-04-27).
//
// Hourly Yad2 metadata watcher. Stores SAFE METADATA ONLY: no images,
// no descriptions, no phone numbers, no HTML. Every CRM render must
// surface `originalUrl` as "פתח במקור" — the data here is a pointer
// to the source, not a clone.
//
// See MARKET_DISCOVERY_PLAN.md for the full design.
// ────────────────────────────────────────────────────────────────────

model MarketListingSource {
  id         String   @id @default(cuid())
  name       String   @unique
  baseUrl    String
  isEnabled  Boolean  @default(true)
  // Safety cap — listings ingested per hourly run for this source.
  // Existing yad2-crawler.ts has its own MAX_LISTINGS_TOTAL = 100
  // baked in; this is the watcher-side belt.
  maxPerHour Int      @default(200)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
}

model MarketListing {
  id                String                   @id @default(cuid())
  source            String // matches MarketListingSource.name
  externalListingId String // yad2 listing token
  originalUrl       String // canonical "פתח במקור" link
  city              String?
  neighborhood      String?
  street            String?
  propertyType      String?
  rooms             Float?
  sizeSqm           Int?
  floor             Int?
  price             Int?
  pricePerSqm       Int?
  // Yad2 splits its catalogue into these two top-level kinds.
  // Madlan/Komo will follow the same dichotomy.
  kind              MarketListingKind?
  // Yad2 splits its feed into private + agency buckets. Useful to
  // filter out agency listings (the agent already works with most
  // local agencies and wants raw deal flow).
  posterType        MarketListingPosterType?
  firstSeenAt       DateTime                 @default(now()) @db.Timestamptz(6)
  lastSeenAt        DateTime                 @default(now()) @db.Timestamptz(6)
  status            MarketListingStatus      @default(active)
  // sha256 of canonicalized metadata; new snapshots only when this changes.
  metadataHash      String
  // Reactor cursor (Phase 3 refactor). NULL = the backend
  // marketDiscoveryReactor hasn't processed this row yet (= run
  // matching against active LeadSearchProfiles + create Notifications
  // for hits). Non-null = processed at this timestamp. Setting back
  // to NULL forces a re-evaluation (e.g. when matching weights
  // change). Watcher service NEVER touches this column — it's the
  // CRM/reactor's bookkeeping.
  reactedAt         DateTime?                @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(6)

  snapshots     MarketListingSnapshot[]
  leadMatches   MarketListingLeadMatch[]
  // Back-relation for Property.marketListing (additive column on
  // Property). When an agent duplicates a listing into their own CRM
  // properties, the Property row points back here so "Open Original"
  // remains available after duplication.
  crmDuplicates Property[]

  @@unique([source, externalListingId])
  @@index([source])
  @@index([city])
  @@index([neighborhood])
  @@index([propertyType])
  @@index([price])
  @@index([rooms])
  @@index([sizeSqm])
  @@index([firstSeenAt])
  @@index([status])
  @@index([kind])
  @@index([posterType])
  @@index([metadataHash])
  // Reactor's hot path: WHERE reactedAt IS NULL ORDER BY firstSeenAt
  // ASC LIMIT N. The (reactedAt, firstSeenAt) covering index keeps
  // the unprocessed-listing scan a single index range read regardless
  // of how big MarketListing grows.
  @@index([reactedAt, firstSeenAt])
}

model MarketListingSnapshot {
  id              String        @id @default(cuid())
  marketListingId String
  marketListing   MarketListing @relation(fields: [marketListingId], references: [id], onDelete: Cascade)
  capturedAt      DateTime      @default(now()) @db.Timestamptz(6)
  price           Int?
  pricePerSqm     Int?
  status          String
  metadataHash    String
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)

  @@index([marketListingId])
  @@index([capturedAt])
  @@index([price])
  @@index([status])
}

model MarketWatcherRun {
  id                   String                 @id @default(cuid())
  startedAt            DateTime               @default(now()) @db.Timestamptz(6)
  finishedAt           DateTime?              @db.Timestamptz(6)
  status               MarketWatcherRunStatus @default(running)
  source               String
  listingsSeen         Int                    @default(0)
  listingsCreated      Int                    @default(0)
  listingsUpdated      Int                    @default(0)
  snapshotsCreated     Int                    @default(0)
  matchesCreated       Int                    @default(0)
  notificationsCreated Int                    @default(0)
  errorMessage         String?
  metadataJson         Json?
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)

  @@index([startedAt])
  @@index([status])
  @@index([source])
}

// Phase 3 — notification preferences per user. Opt-in for email/SMS;
// internal CRM notifications stay on by default. The watcher reads
// these before queueing an external delivery.
model UserNotificationPreference {
  id                               String   @id @default(cuid())
  userId                           String   @unique
  user                             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  marketMatchInAppEnabled          Boolean  @default(true)
  marketMatchEmailEnabled          Boolean  @default(false)
  marketMatchSmsEnabled            Boolean  @default(false)
  // Optional override for delivery — if NULL we send to user.email.
  // Lets the agent route market-match alerts to a personal address
  // without changing their login email.
  customDeliveryEmail              String?
  // Match score (0..100) below which we never deliver via email/SMS,
  // even if the channel is enabled. Default 40 matches the reactor's
  // MIN_SCORE so toggling email-on actually delivers; agents who want
  // higher-confidence-only can raise it via /settings/notifications.
  minMatchScoreForExternalDelivery Int      @default(40)
  createdAt                        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                        DateTime @updatedAt @db.Timestamptz(6)
}

// Phase 3 — pending external delivery queue. The watcher (separate
// container, no AWS SDK) writes a row here when a match qualifies
// for email/SMS. A backend worker (which has AWS credentials via the
// EC2 instance role) polls status='pending', sends via lib/email.ts,
// flips to 'sent'/'failed', records the attempt.
//
// Decouples the watcher from the SES dependency and gives us
// auditability + retry semantics for free.
model PendingNotificationDelivery {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        String // 'email' | 'sms'
  type           String // 'market_listing_match'
  title          String
  body           String?
  link           String?
  recipientEmail String? // captured at queue time so a later email change doesn't redirect a pending mail
  recipientPhone String?
  status         String    @default("pending") // 'pending' | 'sent' | 'failed' | 'skipped'
  errorMessage   String?
  sentAt         DateTime? @db.Timestamptz(6)
  attemptCount   Int       @default(0)
  idempotencyKey String? // optional dedup hint for the worker
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId, status])
  @@index([idempotencyKey])
}

// 2026-05-06 — digest ledger for batched lead-match emails.
//
// Replaces the old "one PendingNotificationDelivery per (agent,
// listing)" path with a coarser-grained queue: every match the
// reactor wants the agent to know about gets one row here. A
// scheduler runs every 30 minutes, groups undispatched rows by
// agent, sends ONE email per agent listing all of them, and stamps
// `dispatchedAt`. The unique index on (agentId, leadId, marketListingId)
// is the dedup contract — if the reactor re-evaluates a listing it
// can call createMany({ skipDuplicates: true }) and never resurface
// a pair we already mailed about.
model NotificationDispatch {
  id              String    @id @default(cuid())
  agentId         String
  agent           User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leadId          String
  // Generic external-listing id; today this is MarketListing.id.
  // Kept as a free-form string rather than a relation so the table
  // works for future "internal Property"-driven matches without a
  // schema migration.
  marketListingId String
  matchScore      Int       @default(0)
  // Null until the row is included in a sent digest email; once set
  // the row is "spent" and never appears in another digest.
  dispatchedAt    DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@unique([agentId, leadId, marketListingId])
  @@index([agentId, dispatchedAt])
  @@index([dispatchedAt])
}

model MarketListingLeadMatch {
  id              String        @id @default(cuid())
  marketListingId String
  marketListing   MarketListing @relation(fields: [marketListingId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Nullable so legacy "flat-fields" lead matches (no LeadSearchProfile)
  // still get a row. The unique constraint includes searchProfileId so
  // the same listing × lead × profile triple can only fire once.
  searchProfileId String?
  // Denormalized for query speed — equals lead.agentId at insert time.
  // Routes filter on this column directly when serving an agent's matches.
  // P1-6 caveat — if a Lead is ever reassigned to a different agent
  // (no such code path today), every row in this table for that lead
  // must be updated in the same transaction. There is no SQL-level
  // sync; treat this column as derived state that needs explicit
  // maintenance.
  agentUserId     String
  agent           User          @relation(fields: [agentUserId], references: [id], onDelete: Cascade)
  score           Int // 0..100
  reasonsJson     Json
  status          String        @default("new") // "new" | "viewed" | "dismissed" | "duplicated"
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)

  @@unique([marketListingId, leadId, searchProfileId])
  @@index([marketListingId])
  @@index([leadId])
  @@index([searchProfileId])
  @@index([agentUserId])
  @@index([score])
  @@index([status])
  @@index([createdAt])
}
