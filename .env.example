# Estia — environment variables (NO secrets — copy to .env locally and fill in)
# Production values live on the server in /home/ec2-user/estia-new/.env (chmod 600).

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PUBLIC_ORIGIN=https://estia.co.il

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=estia
POSTGRES_PASSWORD=                # set a long random string in prod
POSTGRES_DB=estia

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=                       # 64+ chars, generate with: openssl rand -hex 64

# HMAC secret for the short-lived, per-agent tokens used by the hosted-
# LangGraph agent-tool path (GET /api/ai/agent-token mints; POST
# /api/internal/agent-tool verifies). MUST be separate from JWT_SECRET so
# a leak of one can't forge the other. Required for the LangGraph
# agent-tool path; UNSET = that path is disabled (mint → 503, verify →
# 401/503, everything fails closed). 64-char random:
#   openssl rand -hex 64
ESTIA_AGENT_TOKEN_SECRET=

# Google OAuth (set both; authorized redirect URI must be
# https://estia.co.il/api/auth/google/callback in the GCP console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Observability — PostHog (server-side) ───────────────────────────────────
POSTHOG_PROJECT_API_KEY=          # phc_... project token
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=true

# ── Observability — LangSmith (traces the Anthropic + OpenAI calls) ──────────
# Tracing only activates when LANGSMITH_TRACING=true AND LANGSMITH_API_KEY is
# set; otherwise the wrappers are no-ops and behaviour is unchanged.
LANGSMITH_TRACING=false           # set true to send traces
LANGSMITH_API_KEY=                # lsv2_pt_... (keep secret; never commit)
LANGSMITH_PROJECT=estia           # LangSmith project name traces land in
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Uploads (set to s3 in prod, local in dev) ───────────────────────────────
UPLOADS_BACKEND=local             # one of: local | s3
S3_BUCKET=estia-prod
S3_REGION=eu-north-1
# When UPLOADS_BACKEND=s3 the backend uses these. On EC2 prefer the IAM role
# attached to the instance (estia-prod-app) and leave both keys empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Docker port bindings ────────────────────────────────────────────────────
BACKEND_PORT=6002
BACKEND_BIND_ADDR=127.0.0.1
FRONTEND_PORT=3001
