{
  "name": "market-metadata-watcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hourly Yad2 metadata watcher — METADATA ONLY (no images, no descriptions, no phones). See MARKET_DISCOVERY_PLAN.md.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts --once",
    "start": "node dist/index.js",
    "start:once": "node dist/index.js --once",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "pino": "^9.0.0",
    "playwright": "1.59.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
